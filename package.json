{
  "name": "@kevlns/u-cli-mod",
  "version": "0.3.1",
  "description": "按 Unity Editor 精确版本定位工具链，校验和安装 com.unity.pipeline，并执行工程命令。",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "u-cli-mod": "dist/cli.js"
  },
  "vCli": {
    "manifest": "v-cli.plugin.json"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "routes",
    "templates",
    "v-cli.plugin.json",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "docs/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevlns/u-cli-mod.git"
  },
  "homepage": "https://github.com/kevlns/u-cli-mod#readme",
  "bugs": {
    "url": "https://github.com/kevlns/u-cli-mod/issues"
  },
  "author": "Vant",
  "keywords": [
    "unity",
    "unity-editor",
    "pipeline",
    "cli",
    "windows"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "lint": "eslint src tests --max-warnings=0",
    "pack:guard": "node scripts/pack-guard.mjs",
    "check": "npm run docs:style && npm run build && npm run lint && npm test && npm run pack:guard",
    "preflight:runner": "node scripts/preflight-runner.mjs",
    "e2e:windows": "node scripts/e2e-windows.mjs",
    "test:package": "node scripts/test-package-install.mjs",
    "docs:style": "node scripts/check-documentation.mjs"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7"
  },
  "license": "MIT"
}
